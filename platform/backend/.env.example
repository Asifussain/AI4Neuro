# Unified Neuro Platform - backend environment.
# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# ---- Application ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Supabase ----
# The backend uses a server-only elevated key. Prefer the newer Supabase
# `sb_secret_...` key. Legacy `service_role` JWT keys still work but should only
# be used as a fallback.
#
# SUPABASE_JWT_SECRET is optional for projects still issuing legacy HS256 user
# tokens. Newer Supabase projects use asymmetric JWT signing keys; the backend
# verifies those automatically through the project's JWKS endpoint.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Storage buckets ----
RAW_FILES_BUCKET=raw-files
REPORT_ASSETS_BUCKET=report-assets
REPORTS_BUCKET=reports
VIEWER_SLICES_BUCKET=viewer-slices

# ---- Background jobs ----
JOB_BACKEND=local
LOCAL_JOB_MAX_WORKERS=2

# ---- Uploads ----
LOCAL_TMP_DIR=/tmp/neuro-platform
MAX_UPLOAD_MB=512
# Must comfortably cover how long a large raw scan takes to actually finish
# uploading to Supabase Storage on a slow connection, not just a REST query.
# SUPABASE_HTTP_TIMEOUT_SECONDS=600

# ---- Auth ----
# Keep true for local dev before full auth is wired; MUST be false in production.
AUTH_DEV_BYPASS=true

# ---- EEG pipeline ----
# Defaults already point at ../../Alzheimer-Detection/backend/SIDDHI (relative to
# this repo layout), so these are only needed if you move/containerize the backend.
# EEG_SIDDHI_DIR=
# EEG_CHECKPOINT_ROOT=
# EEG_REFERENCE_DIR=
# EEG_USE_GPU=false

# ---- MRI pipeline ----
# Multiclass-only (CN/MCI/AD). A real ConViT checkpoint is required — without
# one, MRI analysis jobs fail explicitly instead of returning mock predictions.
# CONVIT_CHECKPOINT_PATH=
#
# When USE_CAT12_PREPROCESSING=true, the uploaded raw T1 NIfTI is run through
# CAT12 segmentation first (mwp1/mwp2/p0 + real volumetrics) before ConViT
# inference. Requires a standalone CAT12 + MATLAB Runtime install (see
# platform/backend/models/README.md and app/pipelines/mri/cat12_manager.py).
# When false (default), the uploaded scan is treated as already preprocessed.
# USE_CAT12_PREPROCESSING=false
# CAT12_ROOT=
# CAT12_EXE=
# MCR_ROOT=
# CAT12_OUTPUT_DIR=
# A clean CAT12 run takes ~15-20 min; this needs real margin on top for CPU
# contention with everything else running on a dev machine.
# CAT12_TIMEOUT_SECONDS=3600
# MRI_USE_GPU=false
